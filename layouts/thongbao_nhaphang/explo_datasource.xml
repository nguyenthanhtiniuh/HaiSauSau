<root>
	<TableCollection>
		<ParentTable template="StatsDocItem_Explore">
			<Columns>Id, StatsDocId, DocNo, DocDate, BranchCode, Lock, PostSL, RowId_DocProcess, DocProcessId, Description, DocStatus, DocCode, 
			FactoryName, StatsDocWoInfo, CreatedBy_Name, CreatedAt, ApprovalStatus, IsActive, BizDocid_RC, DocNo_RC, TransCode, Driver, VehicleName</Columns>
			<Alias>Ct</Alias>
			<FilterKey>DocCode='DO' AND BranchCode='{=Branch()}'</FilterKey>
			<Sort>DocStatus,DocDate DESC</Sort>
			<Evaluators>
				<Eval_Editor>
					<ClassName>BravoCommandKey</ClassName>
					<CommandKey>EDIT_DO</CommandKey>
					<zCtorArgs>PrimaryKeyValue={=ISNULL(Id,-1)};</zCtorArgs>
					<Expr>LASTCOMMAND() IN ('New', 'NewAsCopy', 'Open')</Expr>
				</Eval_Editor>
				<Eval_Reporter>
					<ClassName>BravoCommandKey</ClassName>
					<CommandKey>StatsDocItemViewer</CommandKey>
					<zCtorArgs>AutoRun=True;Id={=Id};</zCtorArgs>
					<Expr>LastCommand() IN ('Viewer','Print', 'QuickPrint', 'Preview')</Expr>
				</Eval_Reporter>
				<Eval_PreviewReporter>
					<ClassName>BravoCommandKey</ClassName>
					<CommandKey>StatsDocItemViewer</CommandKey>
					<zCtorArgs>AutoRun=True;Id={=Id};</zCtorArgs>
				</Eval_PreviewReporter>
			</Evaluators>
